{
  "name": "sigha",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sigha — a free, client-side Salesforce formula debugger: syntax highlighting, simulation, simplification, formatting, and linting. No backend, ever.",
  "license": "MIT",
  "author": "Ryan Faulhaber",
  "homepage": "https://sigha.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rfaulhaber/sigha.git"
  },
  "bugs": {
    "url": "https://github.com/rfaulhaber/sigha/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "decimal.js": "^10.6.0",
    "lz-string": "^1.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fast-check": "^4.9.0",
    "fast-xml-parser": "^5.10.1",
    "globals": "^17.11.0",
    "playwright": "1.61.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  }
}
